# Copy this file to .env and fill in your keys. Never commit .env.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# --- LLM providers (OpenAI-compatible APIs) ---
# Order in which providers are tried; the next one is used on rate limits or errors.
# groq-fast = the same Groq key planning on gpt-oss-20b (Groq limits are per model)
LLM_PROVIDER_CHAIN=cerebras-qwen,groq,cerebras,groq-fast,openrouter

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PLANNER_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_PLANNER_MODEL=gpt-oss-120b
# Used by provider name "cerebras-qwen" in LLM_PROVIDER_CHAIN
CEREBRAS_QWEN_MODEL=qwen-3.8-27b

# Decider backend: llm (default) or jev (TypeSafe JEV, LLM as fallback)
DECIDER_BACKEND=llm
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Paid, optional: add "openai" to LLM_PROVIDER_CHAIN to use it
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5-mini
OPENAI_FAST_MODEL=gpt-5-nano

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free model that passed the tool-call smoke test. Free models change often:
# leave empty and run `poetry run poe smoke-openrouter` to pick a new one.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Local development (Ollama on your machine)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_FAST_MODEL=qwen3:4b

# --- Voice ---
DEEPGRAM_API_KEY=
# Speech-to-text: deepgram (streaming, lowest latency) or groq (Whisper over HTTP, uses GROQ_API_KEY)
VOICE_STT=deepgram
# Text-to-speech: deepgram (streaming) or deepgram-http (for networks that block WebSockets)
VOICE_TTS=deepgram

# --- Datasets (Svarah is gated on Hugging Face) ---
HF_TOKEN=

# --- App ---
# At least 32 characters. If shorter, the gateway uses a random secret per run.
JWT_SECRET=
# Leave empty for in-memory sessions (single gateway). For several gateways: redis://localhost:6379/0
REDIS_URL=
